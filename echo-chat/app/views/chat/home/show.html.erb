<% title "Echo Chat" %>
<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow">Support chatbot</p>
      <h1 id="hero-title">Answer faster with Echo.</h1>
      <p>Keyword bot replies, canned macros, and a live agent inbox — built on Vela Foundation accounts and organizations.</p>
      <div class="md-actions">
        <% if user_signed_in? %>
          <%= link_to "Open inbox", chat_inbox_path, class: "md-button md-button--filled" %>
        <% else %>
          <%= link_to "Start free", new_user_registration_path, class: "md-button md-button--filled" %>
          <%= link_to "Sign in", new_user_session_path, class: "md-button md-button--outlined" %>
        <% end %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>
<section class="md-section">
  <div class="md-section__inner">
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature"><h3>Bot first</h3><p>Keyword triggers and smart fallbacks deflect common questions before they hit your queue.</p></article>
      <article class="md-card md-card--filled md-feature"><h3>Agent inbox</h3><p>Claim conversations, send macros, and close threads from one Material shell.</p></article>
      <article class="md-card md-card--filled md-feature"><h3>Workspace scoped</h3><p>Every conversation and canned reply lives inside your organization boundary.</p></article>
    </div>
  </div>
</section>
