<% identity = Rails.configuration.x.foundation %>
<% title identity[:default_page_title] %>
<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow"><%= identity[:application_name] %></p>
      <h1 id="hero-title">Pipeline-first CRM for teams that ship.</h1>
      <p>Contacts, companies, leads, opportunities, tasks, and activity — scoped to every organization workspace.</p>
      <div class="md-actions">
        <% if user_signed_in? %>
          <%= link_to "Open CRM", crm_root_path, class: "md-button md-button--filled" %>
          <%= link_to "Workspaces", organizations.organizations_path, class: "md-button md-button--outlined" %>
        <% else %>
          <%= link_to "Start free", new_user_registration_path, class: "md-button md-button--filled" %>
          <%= link_to "Sign in", new_user_session_path, class: "md-button md-button--outlined" %>
        <% end %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>
<section class="md-section">
  <div class="md-section__inner">
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature"><h3>Leads to revenue</h3><p>Capture leads, qualify fast, and push opportunities through customizable pipelines.</p></article>
      <article class="md-card md-card--filled md-feature"><h3>Account graph</h3><p>Companies and contacts stay linked with notes, tags, and a full activity timeline.</p></article>
      <article class="md-card md-card--filled md-feature"><h3>Tasking</h3><p>Owners get clear next steps so deals do not stall between meetings.</p></article>
    </div>
  </div>
</section>
