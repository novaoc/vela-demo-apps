#!/usr/bin/env bash
set -eo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${HOME}/.local/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/opt/postgresql@15/bin:$PATH"
export LDFLAGS="-L/opt/homebrew/opt/libpq/lib"
export CPPFLAGS="-I/opt/homebrew/opt/libpq/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/libpq/lib/pkgconfig"
eval "$(mise activate bash)" 2>/dev/null || true

for app in lumen-market northstar-crm nebula-quest pokevault echo-chat; do
  echo "==== setup $app ===="
  cd "$ROOT/$app"
  bundle config set --local path 'vendor/bundle'
  bundle install
  bin/rails db:prepare
  bin/rails tailwindcss:build
  bin/rails db:seed || true
done
echo "All apps prepared."
